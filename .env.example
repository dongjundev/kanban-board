# docker-compose.prod.yml용 환경변수. 이 파일을 .env로 복사하고 실제 값을 넣으세요.
# .env는 커밋하지 마세요(.gitignore에 포함됨).
POSTGRES_PASSWORD=change-me-to-a-strong-password

# 로그인 계정. 비밀번호를 비우면 인증이 꺼지므로 운영에서는 반드시 채우세요
# (docker-compose.prod.yml이 비어 있으면 기동을 거부합니다).
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change-me-to-a-strong-password
